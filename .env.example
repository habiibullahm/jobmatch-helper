BOT_TOKEN=your_telegram_bot_token_here
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
# Adzuna has NO Indonesia (id) index — id returns HTTP 404.
# Closest SEA option that works: sg. Also: gb, us, au, in, etc.
ADZUNA_COUNTRY=sg
DATA_DIR=./data
INDO_JOBS_PATH=./data/jobs-id.json
STRONG_MATCH_MIN=70
DIGEST_MATCH_MIN=40
ALERT_POLL_MINUTES=120
DIGEST_HOUR_WIB=9
